{
  "manifest_version": 3,
  "name": "Kilo Code",
  "description": "Side-panel AI chat agent. Use open-weight or frontier models.",
  "version": "0.1.1",
  "icons": {
    "16": "icon/16.png",
    "32": "icon/32.png",
    "48": "icon/48.png",
    "96": "icon/96.png",
    "128": "icon/128.png"
  },
  "action": {
    "default_title": "Kilo",
    "default_popup": "sidepanel.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kilo-extension@kilocode.ai",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "host_permissions": [
    "<all_urls>",
    "file:///*",
    "https://app.kilo.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "permissions": [
    "identity",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'self'"
  }
}